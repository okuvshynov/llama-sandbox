#version 450
// Null-scale stand-in for moe-serv's tp_final: 3 storage buffers.
layout(local_size_x = 64) in;
layout(binding = 0) readonly  buffer B0 { uint v[]; } part;
layout(binding = 1) readonly  buffer B1 { uint v[]; } wts;
layout(binding = 2) writeonly buffer B2 { uint v[]; } y;
layout(push_constant) uniform PC { uint u[7]; } pc;
void main() {
    if (gl_GlobalInvocationID.x == 0u) {
        y.v[0] = part.v[0] + wts.v[0] + pc.u[0];
    }
}
