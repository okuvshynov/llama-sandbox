#version 450
// Null-scale stand-in for moe-serv's tp_mid: 2 storage buffers.
layout(local_size_x = 64) in;
layout(binding = 0) readonly  buffer B0 { uint v[]; } part;
layout(binding = 1) writeonly buffer B1 { uint v[]; } h;
layout(push_constant) uniform PC { uint u[7]; } pc;
void main() {
    if (gl_GlobalInvocationID.x == 0u) {
        h.v[0] = part.v[0] + pc.u[0];
    }
}
