#version 450
// h = silu(gate) * up, elementwise. The swiglu step between an expert's
// up/gate projections and its down projection.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer G { float g[]; };
layout(std430, binding = 1) readonly  buffer U { float u[]; };
layout(std430, binding = 2) writeonly buffer H { float h[]; };

layout(push_constant) uniform PC { uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float gv = g[i];
    h[i] = (gv / (1.0 + exp(-gv))) * u[i];
}
