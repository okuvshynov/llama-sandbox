--- /dev/null
+++ b/ds-completion/src/mxfp8.h
@@ -0,0 +1,20 @@
+// The Engram table's rows as the GGUF files hold them (the PR's MXFP8, ggml type id 43 there):
+// blocks of 33 bytes, one e8m0 scale then 32 e4m3 codes; value = e4m3(code) * 2^(scale - 127).
+// Decoded here, so that nothing depends on what ggml's type 43 means (upstream: plain fp8).
+#pragma once
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+inline size_t mxfp8_row_bytes(int64_t n) { return (size_t)n / 32 * 33; }
+inline float mxfp8_e4m3(uint8_t c) {
+  const int e = (c >> 3) & 15, m = c & 7;
+  const float v = e == 0 ? std::ldexp((float)m, -9) : std::ldexp((float)(8 + m), e - 10);
+  return (c & 0x80) ? -v : v;
+}
+inline void mxfp8_to_float(const void* src, float* y, int64_t n) {
+  const uint8_t* b = (const uint8_t*)src;
+  for (int64_t i = 0; i < n / 32; i++, b += 33) {
+    const float d = std::ldexp(1.0f, (int)b[0] - 127);
+    for (int j = 0; j < 32; j++) y[i * 32 + j] = mxfp8_e4m3(b[1 + j]) * d;
+  }
+}
