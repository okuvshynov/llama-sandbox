+// a block's 16 code bytes as signed bytes 2 w: low nibbles (elements 0-15), high (16-31)
+struct CanonW { int lo[4], hi[4]; };
+__device__ inline CanonW canon_decode(uint4 w) {
+  const uint32_t wv[4] = {w.x, w.y, w.z, w.w};
+  CanonW d;
+#pragma unroll
+  for (int g = 0; g < 4; g++) {
+    d.lo[g] = canon_w4(wv[g] & 0x0F0F0F0Fu);
+    d.hi[g] = canon_w4((wv[g] >> 4) & 0x0F0F0F0Fu);
+  }
+  return d;
