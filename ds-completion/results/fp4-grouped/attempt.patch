+__global__ void __launch_bounds__(1024) canon_group_kernel(ExpertSel sel, int k, int M, int P2, CanonGroups G) {
+  __shared__ uint32_t key[kGroupMax];
+  const int P = M * k;
+  for (int i = threadIdx.x; i < P2; i += blockDim.x) {
+    const int t = i / k, j = i - t * k;
+    const bool valid = i < P && j < canon_count(sel, k, t);
+    key[i] = valid ? ((uint32_t)sel.ids[t * sel.stride + j] << 12 | (uint32_t)i) : 0xFFFFFFFFu;
+  }
+  __syncthreads();
+  for (int size = 2; size <= P2; size <<= 1)  // bitonic sort, ascending
+    for (int st = size >> 1; st > 0; st >>= 1) {
+      for (int i = threadIdx.x; i < P2; i += blockDim.x) {
+        const int o = i ^ st;
+        if (o > i) {
+          const uint32_t a = key[i], b = key[o];
+          if (((i & size) == 0) == (a > b)) { key[i] = b; key[o] = a; }
+        }
+      }
+      __syncthreads();
+    }
+  for (int i = threadIdx.x; i < P2; i += blockDim.x)
+    if (key[i] != 0xFFFFFFFFu) G.pair[i] = (int)(key[i] & 4095u);
+  if (threadIdx.x == 0) {
+    int n = 0, i = 0;
+    for (; i < P2 && key[i] != 0xFFFFFFFFu; i++)
+      if (i == 0 || (key[i] >> 12) != (key[i - 1] >> 12)) {
+        G.start[n] = i;
+        G.slot[n] = (int)(key[i] >> 12);
+        n++;
+      }
+    G.start[n] = i;
+    *G.n = n;
+  }
+}
