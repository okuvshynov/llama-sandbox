+    P1 = __builtin_amdgcn_sdot4(d.hi[g], b1[g], P1, false);
+    P2 = __builtin_amdgcn_sdot4(d.lo[g], a2[g], P2, false);
+    P2 = __builtin_amdgcn_sdot4(d.hi[g], b2[g], P2, false);
+  }
+  return P0 + (P1 << 7) + (P2 << 14);
