+// canon_block on decoded weights: the same integer operations in the same order
+__device__ inline int canon_block_dec(const CanonW& d, const CanonX& x) {
+  const int* a0 = x.v[0][0]; const int* b0 = x.v[0][1];
+  const int* a1 = x.v[1][0]; const int* b1 = x.v[1][1];
+  const int* a2 = x.v[2][0]; const int* b2 = x.v[2][1];
