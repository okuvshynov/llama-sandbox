+struct CanonGroups {
+  int* n;      // number of groups
+  int* start;  // [n + 1]: group g's pairs are pair[start[g] .. start[g + 1])
+  int* slot;   // [n]: the expert (slot) of group g
+  int* pair;   // [pairs]: t k + j, sorted by slot, then by pair
+};
