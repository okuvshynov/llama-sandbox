+// the layer gate (README step 85)
+namespace {
+std::mutex g_gate_mu;
+std::condition_variable g_gate_cv;
+long g_epoch = 0;
+std::atomic<bool> g_gate_on{false};
+int g_gate_mode = 0;              // 1: one matrix per layer; 2: none while a layer's expert phase runs
+bool g_in_phase = false;          // mode 2: between loader_phase(true) and (false)
+void gate_wait(long& last, int& count) {
+  if (!g_gate_on) return;
+  std::unique_lock<std::mutex> lk(g_gate_mu);
+  if (g_gate_mode == 2) {
+    g_gate_cv.wait_for(lk, std::chrono::milliseconds(20), [&] { return !g_in_phase || !g_gate_on; });
+    return;
+  }
+  // mode 1: up to g_per_layer matrices per stage per layer (DS_LOAD_PER_LAYER, default 1)
+  static const int per_layer = getenv("DS_LOAD_PER_LAYER") ? atoi(getenv("DS_LOAD_PER_LAYER")) : 1;
+  if (g_epoch > last) { last = g_epoch; count = 0; }
+  if (count < per_layer) { count++; return; }
+  g_gate_cv.wait_for(lk, std::chrono::milliseconds(20), [&] { return g_epoch > last || !g_gate_on; });
+  last = g_epoch;
+  count = 1;
+}
+}  // namespace
+
+void loader_gate_enable(int mode) {
+  g_gate_mode = mode;
+  g_gate_on = mode > 0;
+  g_gate_cv.notify_all();
+}
+
+void loader_phase(bool in) {
+  if (!g_gate_on || g_gate_mode != 2) return;
+  {
+    std::lock_guard<std::mutex> lk(g_gate_mu);
+    g_in_phase = in;
+  }
+  if (!in) g_gate_cv.notify_all();
+}
+
+void loader_layer_done() {
+  if (!g_gate_on) return;
+  {
+    std::lock_guard<std::mutex> lk(g_gate_mu);
+    g_epoch++;
+  }
+  g_gate_cv.notify_all();
+}
