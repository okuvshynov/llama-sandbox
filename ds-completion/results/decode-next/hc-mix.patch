+// README step 99: one sublayer's mixing in one kernel instead of three (the split sum of the
+// hc_fn GEMV's partials, hc_split_kernel, hc_pre_kernel with the norm). Each part's arithmetic is
+// the kernel's it replaces, statement for statement, so the bits are the same. One block per
+// token; partial: gemv_partial_m_kernel's (token, split, row) sums of fn . h_flat.
+__global__ void hc_mix_kernel(const float* h, int n, const float* partial, int splits, const float* scale, const float* base,
+                              float norm_eps, float hc_eps, int iters, const float* pre_in, const float* w, float* pre,
+                              float* post, float* comb, float* x) {
+  constexpr int HC = 4, MIX = (2 + HC) * HC;
+  __shared__ float buf[8192];
+  const int n_flat = HC * n;
+  h += (size_t)blockIdx.x * n_flat;  // token blockIdx.x
+  partial += (size_t)blockIdx.x * splits * MIX;
+  pre_in += blockIdx.x * HC;
+  pre += blockIdx.x * HC;
+  post += blockIdx.x * HC;
+  comb += blockIdx.x * HC * HC;
+  x += (size_t)blockIdx.x * n;
+  {  // hc_pre_kernel, norm: x = rms(sum_j pre_in[j] h[j]) * w
+    float ss = 0;
+    for (int i = threadIdx.x; i < n; i += blockDim.x) {
+      float v = 0;
+      for (int j = 0; j < 4; j++) v += pre_in[j] * h[(size_t)j * n + i];
+      buf[i] = v;
+      ss += v * v;
+    }
+    const float r = rsqrtf(block_sum(ss) / n + norm_eps);
+    for (int i = threadIdx.x; i < n; i += blockDim.x) x[i] = buf[i] * r * w[i];
+  }
+  // hc_split_kernel
+  float ss = 0;
+  for (int i = threadIdx.x; i < n_flat; i += blockDim.x) ss += h[i] * h[i];
+  const float r = rsqrtf(block_sum(ss) / n_flat + norm_eps);
+  const int t = threadIdx.x;
+  if (t >= 64) return;
+  auto mix = [&](int row) {  // split_sum_m_kernel
+    float v = 0;
+    for (int sp = 0; sp < splits; sp++) v += partial[(size_t)sp * MIX + row];
+    return v;
+  };
+  if (t < HC) pre[t] = sigmoidf(mix(t) * r * scale[0] + base[t]) + hc_eps;
+  else if (t < 2 * HC) post[t - HC] = 2.0f * sigmoidf(mix(t) * r * scale[1] + base[t]);
+  const int e = t & 15;
+  float c = mix(2 * HC + e) * r * scale[2] + base[2 * HC + e];
+  auto row_sum = [&](float v) { v += __shfl_xor(v, 1, 64); v += __shfl_xor(v, 2, 64); return v; };
+  auto col_sum = [&](float v) { v += __shfl_xor(v, 4, 64); v += __shfl_xor(v, 8, 64); return v; };
+  float mx = fmaxf(c, __shfl_xor(c, 1, 64));
+  mx = fmaxf(mx, __shfl_xor(mx, 2, 64));
+  c = expf(c - mx);
+  c = c / row_sum(c) + hc_eps;
+  c = c / (col_sum(c) + hc_eps);
+  for (int it = 1; it < iters; it++) {
+    c = c / (row_sum(c) + hc_eps);
+    c = c / (col_sum(c) + hc_eps);
+  }
+  if (t < 16) comb[e] = c;
+}
+
+void k_hc_mix(const float* fn, const float* h, int n, const float* scale, const float* base, float norm_eps, float hc_eps,
+              int iters, const float* pre_in, const float* w, float* pre, float* post, float* comb, float* x, float* partial,
+              hipStream_t s, int M) {
+  constexpr int HC = 4, MIX = (2 + HC) * HC, VEC = 4;
+  const int K = HC * n;
+  if (n > 8192) throw std::runtime_error("k_hc_mix: n");
+  int splits = 1;  // exactly as gemv()
+  while (splits < kSplitMax && (int64_t)MIX * splits < 2048 && K / (splits * 2) >= 64 * VEC * 2) splits *= 2;
+  const int step = 64 * VEC, chunk = cdiv(cdiv(K, splits), step) * step;
+  splits = cdiv(K, chunk);
+  for (int m0 = 0; m0 < M; m0 += 8) {
+    const int mm = std::min(8, M - m0);
+    const float* hm = h + (size_t)m0 * K;
+    const dim3 grid(cdiv(MIX, 4), splits);
+    switch (mm) {
+#define CASE(q) case q: gemv_partial_m_kernel<float, VEC, q, 1><<<grid, 256, 0, s>>>(fn, MIX, K, chunk, hm, partial); break;
+      CASE(1) CASE(2) CASE(3) CASE(4) CASE(5) CASE(6) CASE(7) CASE(8)
+#undef CASE
+    }
+    hc_mix_kernel<<<mm, 1024, 0, s>>>(hm, n, partial, splits, scale, base, norm_eps, hc_eps, iters, pre_in + m0 * HC, w,
+                                      pre + m0 * HC, post + m0 * HC, comb + m0 * HC * HC, x + (size_t)m0 * n);
+  }
+}
