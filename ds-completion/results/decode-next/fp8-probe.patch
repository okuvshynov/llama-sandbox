+// THE CEILING PROBE (bench only, not exact). A wave covers 64 / LPR row sets of R consecutive rows; LPR lanes split K for each set, each
+// lane stepping 16 codes at a time. R divides 32, so the R rows share one weight scale row.
+template <int LPR, int R, int M, int MODE>
+__global__ void __launch_bounds__(256) fp8_probe_kernel(const uint8_t* __restrict__ w, const uint8_t* __restrict__ ws,
+                                                       int N, int K, int rpg, const uint8_t* __restrict__ xq,
+                                                       const float* __restrict__ xs, float* __restrict__ y) {
+  const int lane = threadIdx.x & 63;
+  const int set = (blockIdx.x * (blockDim.x >> 6) + (threadIdx.x >> 6)) * (64 / LPR) + lane / LPR;
+  const int row0 = set * R;
+  const int l = lane % LPR;
+  const bool live = row0 < N;
+  const int r0 = live ? row0 : N - R;  // dead lanes still take part in the shuffles
+  const int g = r0 / rpg;              // R rows never straddle a group (rpg is a multiple of 32)
+  const int K_total = K * (N / rpg);
+  const uint8_t* wr = w + (size_t)r0 * K;
+  const uint8_t* sr = ws + (size_t)(r0 / 32) * (K / 32);
+  const uint8_t* xr = xq + (size_t)g * K;
+  const float* xsr = xs + (size_t)g * (K / 32);
+  float acc[R][M];
+#pragma unroll
+  for (int i = 0; i < R; i++)
+#pragma unroll
+    for (int m = 0; m < M; m++) acc[i][m] = 0.0f;
+
+  // bench only (the ceiling probe): MODE 1 no activation decode; 2 nor weight decode; 3 and the
+  // activations loaded once, before the loop; 5 weight loads only
+  auto raw8 = [](const uint4 v, uint32_t* h) { h[0] = v.x; h[1] = v.y; h[2] = v.z; h[3] = v.w; h[4] = v.x; h[5] = v.y; h[6] = v.z; h[7] = v.w; };
+  uint32_t hx[M][8];
+  float sx[M];
+  if (MODE >= 3) {
+#pragma unroll
+    for (int m = 0; m < M; m++) {
+      raw8(*(const uint4*)(xr + (size_t)m * K_total + l * 16), hx[m]);
+      sx[m] = xsr[(size_t)m * (K_total / 32) + l / 2];
+    }
+  }
+  for (int k = l * 16; k < K; k += LPR * 16) {
+    if (MODE < 3) {
+#pragma unroll
+      for (int m = 0; m < M; m++) {
+        if (MODE == 0) decode16(*(const uint4*)(xr + (size_t)m * K_total + k), hx[m]);
+        else raw8(*(const uint4*)(xr + (size_t)m * K_total + k), hx[m]);
+        sx[m] = xsr[(size_t)m * (K_total / 32) + k / 32];
+      }
+    }
+    const float wscale = __uint_as_float((uint32_t)sr[k / 32] << 23) * 65536.0f;  // 2^(e-127), times the 2^16 undone
+#pragma unroll
+    for (int i = 0; i < R; i++) {
+      uint32_t hw[8];
+      if (MODE < 2) decode16(*(const uint4*)(wr + (size_t)i * K + k), hw);
+      else raw8(*(const uint4*)(wr + (size_t)i * K + k), hw);
+      if (MODE == 5) {
+        acc[i][0] += __uint_as_float((hw[0] ^ hw[1] ^ hw[2] ^ hw[3]) & 0x3fffffffu) * wscale;
+        continue;
+      }
+#pragma unroll
+      for (int m = 0; m < M; m++) {
+        float p = 0.0f;
+#pragma unroll
+        for (int j = 0; j < 8; j++) p = dot2(hw[j], hx[m][j], p);
+        acc[i][m] += p * (wscale * sx[m]);
+      }
+    }
+  }
+#pragma unroll
+  for (int i = 0; i < R; i++)
+#pragma unroll
+    for (int m = 0; m < M; m++) {
+      float v = acc[i][m];
+#pragma unroll
+      for (int o = LPR / 2; o > 0; o >>= 1) v += __shfl_xor(v, o, 64);
+      if (live && l == 0) y[(size_t)m * N + row0 + i] = v;
+    }
+}
