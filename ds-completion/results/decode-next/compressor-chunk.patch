+// A chunk of M tokens at positions p0 .. through the compressor's group state (README step 99):
+// per element what the one-token path did token by token: each token's rows into its slot
+// (pos % ratio), a pooled latent for every group a token completes (compress_pool_kernel's
+// arithmetic over the slots as they are then), the state left as after the last token.
+// rows (or null): each token's [kv | score] row, for a verify step's commit.
+__global__ void compress_chunk_kernel(const float* kvn, const float* scn, float* kv_state, float* sc_state, int ratio, int dim,
+                                      int p0, int M, float* out, float* rows) {
+  constexpr int kMaxRatio = 8;
+  const int d = blockIdx.x * blockDim.x + threadIdx.x;
+  if (d >= dim) return;
+  float kv[kMaxRatio], sc[kMaxRatio];
+  for (int i = 0; i < ratio; i++) {
+    kv[i] = kv_state[(size_t)i * dim + d];
+    sc[i] = sc_state[(size_t)i * dim + d];
+  }
+  int g = 0;
+  for (int t = 0; t < M; t++) {
+    const int q = (p0 + t) % ratio;
+    kv[q] = kvn[(size_t)t * dim + d];
+    sc[q] = scn[(size_t)t * dim + d];
+    if (rows) {
+      rows[(size_t)t * 2 * dim + d] = kv[q];
+      rows[(size_t)t * 2 * dim + dim + d] = sc[q];
+    }
+    if (q != ratio - 1) continue;
+    float mx = -INFINITY;
+    for (int i = 0; i < ratio; i++) mx = fmaxf(mx, sc[i]);
+    float num = 0, den = 0;
+    for (int i = 0; i < ratio; i++) {
+      const float p = expf(sc[i] - mx);
+      num += kv[i] * p;
+      den += p;
+    }
+    out[(size_t)g++ * dim + d] = num / den;
+  }
+  for (int i = 0; i < ratio; i++) {
+    kv_state[(size_t)i * dim + d] = kv[i];
+    sc_state[(size_t)i * dim + d] = sc[i];
+  }
+}
+
+void k_compress_chunk(const float* kvn, const float* scn, float* kv_state, float* score_state, int ratio, int dim, int p0, int M,
+                      float* pooled, float* rows, hipStream_t s) {
+  if (ratio > 8) throw std::runtime_error("k_compress_chunk: ratio");
+  compress_chunk_kernel<<<cdiv(dim, 256), 256, 0, s>>>(kvn, scn, kv_state, score_state, ratio, dim, p0, M, pooled, rows);
+}
