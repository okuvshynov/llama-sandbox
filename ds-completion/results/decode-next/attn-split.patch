+__device__ inline void xdie_copy(const XRegion& a, const XRegion& b, int rows) {
+  const int wa = a.width / 16, wb = b.width / 16, na = rows * wa, n = na + rows * wb;
+  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) {
