diff --git a/ds-completion/hip/bench_xdie.cpp b/ds-completion/hip/bench_xdie.cpp
new file mode 100644
index 0000000..4965d40
--- /dev/null
+++ b/ds-completion/hip/bench_xdie.cpp
@@ -0,0 +1,239 @@
+// bench-xdie: what a hand-off between the XGMI pair's dies costs (attention over dies 0-1, PLAN C2).
+// A ping-pong: die A writes a payload (a verify chunk's activations, T x 5120 fp32), die B takes it
+// and writes one back, N times; per hand-off = total / (2 N). Methods:
+//   same-die  two streams on die 0 with an event between them (the baseline: no second die)
+//   event+read   hipStreamWaitEvent on the other die's event, then a kernel reads the peer's memory
+//   event+copy   hipStreamWaitEvent, then hipMemcpyPeerAsync into local memory
+//   flag         no events: the consumer's kernel is queued ahead and spins on a flag the producer's
+//                kernel sets after its stores (fine-grained memory, system-scope fences)
+//   bin-hip/bench-xdie [T]       the hand-off alone
+//   bin-hip/bench-xdie proj      attention's output (wo_a, wo_b shapes) on die 0 vs split over 0-1, M = 1..8
+#include <hip/hip_runtime.h>
+#include "fp8_gemv.h"
+#include "kernels.h"
+#include <vector>
+#include <cstring>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#define CK(x) do { hipError_t e_ = (x); if (e_ != hipSuccess) { printf("%s: %s\n", #x, hipGetErrorString(e_)); exit(1); } } while (0)
+
+// out[i] = in[i] + 1 (in may be the peer's memory)
+__global__ void step(const float* in, float* out, int n) {
+  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) out[i] = in[i] + 1.0f;
+}
+// one thread: wait until the local flag reaches want (written by the other die)
+__global__ void wait_flag(const int* flag, int want) {
+  while (__hip_atomic_load(flag, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM) < want) __builtin_amdgcn_s_sleep(1);
+}
+// one thread, after the stream's previous kernel: make its stores visible, then set the peer's flag
+__global__ void signal_flag(int* peer_flag, int v) {
+  __threadfence_system();
+  __hip_atomic_store(peer_flag, v, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_SYSTEM);
+}
+
+int proj_main();
+int main(int argc, char** argv) {
+  if (argc > 1 && !strcmp(argv[1], "proj")) return proj_main();
+  const int T = argc > 1 ? atoi(argv[1]) : 6;
+  const int n = T * 5120;
+  const size_t bytes = (size_t)n * 4;
+  int can = 0;
+  CK(hipDeviceCanAccessPeer(&can, 0, 1));
+  if (!can) { printf("no peer access 0<->1\n"); return 1; }
+  CK(hipSetDevice(0)); CK(hipDeviceEnablePeerAccess(1, 0));
+  CK(hipSetDevice(1)); CK(hipDeviceEnablePeerAccess(0, 0));
+  float *a[2], *b[2];  // a: written by its die, read by the other; b: local landing buffer
+  int* flag[2];
+  hipStream_t s[2], s0b;
+  hipEvent_t ev[2], ev0b;
+  for (int d = 0; d < 2; d++) {
+    CK(hipSetDevice(d));
+    CK(hipExtMallocWithFlags((void**)&a[d], bytes, hipDeviceMallocFinegrained));
+    CK(hipMalloc(&b[d], bytes));
+    CK(hipExtMallocWithFlags((void**)&flag[d], 64, hipDeviceMallocFinegrained));
+    CK(hipMemset(a[d], 0, bytes)); CK(hipMemset(flag[d], 0, 64));
+    CK(hipStreamCreateWithFlags(&s[d], hipStreamNonBlocking));
+    CK(hipEventCreateWithFlags(&ev[d], hipEventDisableTiming));
+  }
+  CK(hipSetDevice(0));
+  CK(hipStreamCreateWithFlags(&s0b, hipStreamNonBlocking));
+  CK(hipEventCreateWithFlags(&ev0b, hipEventDisableTiming));
+  CK(hipDeviceSynchronize());
+  using C = std::chrono::steady_clock;
+  auto us = [](C::time_point t) { return std::chrono::duration<double, std::micro>(C::now() - t).count(); };
+  const int G = (n + 255) / 256 < 64 ? (n + 255) / 256 : 64, N = 2000;
+  printf("# bench-xdie: T=%d (%zu KB per hand-off), %d round trips, per hand-off in us\n", T, bytes / 1024, N);
+  for (int rep = 0; rep < 3; rep++) {
+    // same die, two streams
+    auto t0 = C::now();
+    for (int i = 0; i < N; i++) {
+      step<<<G, 256, 0, s[0]>>>(b[0], a[0], n); CK(hipEventRecord(ev[0], s[0]));
+      CK(hipStreamWaitEvent(s0b, ev[0], 0));
+      step<<<G, 256, 0, s0b>>>(a[0], b[0], n); CK(hipEventRecord(ev0b, s0b));
+      CK(hipStreamWaitEvent(s[0], ev0b, 0));
+    }
+    double sub = us(t0); CK(hipStreamSynchronize(s[0])); double tot = us(t0);
+    printf("same-die      %7.2f   (host submit %.2f)\n", tot / (2 * N), sub / (2 * N));
+    // event + peer read
+    t0 = C::now();
+    for (int i = 0; i < N; i++) {
+      CK(hipSetDevice(0)); step<<<G, 256, 0, s[0]>>>(b[0], a[0], n); CK(hipEventRecord(ev[0], s[0]));
+      CK(hipSetDevice(1)); CK(hipStreamWaitEvent(s[1], ev[0], 0));
+      step<<<G, 256, 0, s[1]>>>(a[0], a[1], n); CK(hipEventRecord(ev[1], s[1]));
+      CK(hipSetDevice(0)); CK(hipStreamWaitEvent(s[0], ev[1], 0));
+      step<<<G, 256, 0, s[0]>>>(a[1], b[0], n);
+    }
+    sub = us(t0); CK(hipStreamSynchronize(s[0])); tot = us(t0);
+    printf("event+read    %7.2f   (host submit %.2f)\n", tot / (2 * N), sub / (2 * N));
+    // event + DMA copy
+    t0 = C::now();
+    for (int i = 0; i < N; i++) {
+      CK(hipSetDevice(0)); step<<<G, 256, 0, s[0]>>>(b[0], a[0], n); CK(hipEventRecord(ev[0], s[0]));
+      CK(hipSetDevice(1)); CK(hipStreamWaitEvent(s[1], ev[0], 0));
+      CK(hipMemcpyPeerAsync(b[1], 1, a[0], 0, bytes, s[1]));
+      step<<<G, 256, 0, s[1]>>>(b[1], a[1], n); CK(hipEventRecord(ev[1], s[1]));
+      CK(hipSetDevice(0)); CK(hipStreamWaitEvent(s[0], ev[1], 0));
+      CK(hipMemcpyPeerAsync(b[0], 0, a[1], 1, bytes, s[0]));
+    }
+    sub = us(t0); CK(hipStreamSynchronize(s[0])); tot = us(t0);
+    printf("event+copy    %7.2f   (host submit %.2f)\n", tot / (2 * N), sub / (2 * N));
+    // flags: die 0 waits flag0 >= i, works, sets flag1 = i + 1; die 1 waits flag1 >= i + 1, works,
+    // sets flag0 = i + 1. Everything is queued up front; no events, the host only submits.
+    for (int d = 0; d < 2; d++) { CK(hipSetDevice(d)); CK(hipMemset(flag[d], 0, 64)); CK(hipDeviceSynchronize()); }
+    t0 = C::now();
+    for (int i = 0; i < N; i++) {
+      CK(hipSetDevice(0));
+      wait_flag<<<1, 1, 0, s[0]>>>(flag[0], i);
+      step<<<G, 256, 0, s[0]>>>(a[1], a[0], n);
+      signal_flag<<<1, 1, 0, s[0]>>>(flag[1], i + 1);
+      CK(hipSetDevice(1));
+      wait_flag<<<1, 1, 0, s[1]>>>(flag[1], i + 1);
+      step<<<G, 256, 0, s[1]>>>(a[0], a[1], n);
+      signal_flag<<<1, 1, 0, s[1]>>>(flag[0], i + 1);
+    }
+    sub = us(t0);
+    for (int d = 0; d < 2; d++) { CK(hipSetDevice(d)); CK(hipStreamSynchronize(s[d])); }
+    tot = us(t0);
+    printf("flag+read     %7.2f   (host submit %.2f)\n", tot / (2 * N), sub / (2 * N));
+    // check: after N round trips a0 = 2N - 1 + its start, a1 = 2N + ... (only that both moved)
+    float h0 = 0, h1 = 0;
+    CK(hipSetDevice(0)); CK(hipMemcpy(&h0, a[0], 4, hipMemcpyDeviceToHost));
+    CK(hipMemcpy(&h1, a[1], 4, hipMemcpyDeviceToHost));
+    printf("  values after: a0 %.0f a1 %.0f (a1 = a0 + 1 when the hand-offs were ordered)\n", h0, h1);
+    // the kernels alone, one die, one stream (what a hand-off adds to)
+    t0 = C::now();
+    for (int i = 0; i < 2 * N; i++) step<<<G, 256, 0, s[0]>>>(b[0], a[0], n);
+    CK(hipStreamSynchronize(s[0]));
+    printf("kernel alone  %7.2f\n", us(t0) / (2 * N));
+  }
+  return 0;
+}
+
+// ---------------------------------------------------------------- proj: wo_a + wo_b, 40 layers
+// The runtime's sequence (rt.cpp attn_out_split) on random weights: o's codes [M][32768] ->
+// wo_a (8 groups of 1024 rows x 4096) -> quant -> wo_b (5120 x 8192). Full: all on die 0. Split:
+// die 1 takes groups 4-7 and rows 2560.., with the same puts and gets. Checks the split's out
+// against the full one bit for bit.
+static uint8_t* rnd_codes(size_t n, unsigned seed) {
+  std::vector<uint8_t> h(n);
+  for (size_t i = 0; i < n; i++) { seed = seed * 1664525u + 1013904223u; uint8_t c = seed >> 24; if ((c & 0x7f) >= 0x70) c &= 0x8f; h[i] = c; }
+  uint8_t* d; CK(hipMalloc(&d, n)); CK(hipMemcpy(d, h.data(), n, hipMemcpyHostToDevice)); return d;
+}
+static uint8_t* rnd_scales(size_t n) {  // e8m0 around 2^-6
+  std::vector<uint8_t> h(n, 121);
+  uint8_t* d; CK(hipMalloc(&d, n)); CK(hipMemcpy(d, h.data(), n, hipMemcpyHostToDevice)); return d;
+}
+int proj_main() {
+  const int L = 40, Kt = 32768, G = 8, R = 1024, Ka = Kt / G, Na = G * R, E = 5120, ho = Kt / 2, ha = Na / 2, hb = E / 2, MX = 8;
+  CK(hipSetDevice(0)); (void)hipDeviceEnablePeerAccess(1, 0); (void)hipGetLastError();
+  CK(hipSetDevice(1)); (void)hipDeviceEnablePeerAccess(0, 0); (void)hipGetLastError();
+  struct W { uint8_t *aq, *as, *bq, *bs; };
+  std::vector<W> w0(L), w1(L);
+  CK(hipSetDevice(0));
+  for (int l = 0; l < L; l++) w0[l] = {rnd_codes((size_t)Na * Ka, 1 + l), rnd_scales((size_t)Na / 32 * Ka / 32), rnd_codes((size_t)E * Na, 100 + l), rnd_scales((size_t)E / 32 * Na / 32)};
+  CK(hipSetDevice(1));
+  for (int l = 0; l < L; l++) {
+    w1[l] = {nullptr, nullptr, nullptr, nullptr};
+    CK(hipMalloc(&w1[l].aq, (size_t)ha * Ka)); CK(hipMalloc(&w1[l].as, (size_t)ha / 32 * Ka / 32));
+    CK(hipMalloc(&w1[l].bq, (size_t)hb * Na)); CK(hipMalloc(&w1[l].bs, (size_t)hb / 32 * Na / 32));
+    CK(hipMemcpyPeer(w1[l].aq, 1, w0[l].aq + (size_t)ha * Ka, 0, (size_t)ha * Ka));
+    CK(hipMemcpyPeer(w1[l].as, 1, w0[l].as + (size_t)ha / 32 * Ka / 32, 0, (size_t)ha / 32 * Ka / 32));
+    CK(hipMemcpyPeer(w1[l].bq, 1, w0[l].bq + (size_t)hb * Na, 0, (size_t)hb * Na));
+    CK(hipMemcpyPeer(w1[l].bs, 1, w0[l].bs + (size_t)hb / 32 * Na / 32, 0, (size_t)hb / 32 * Na / 32));
+  }
+  auto codes = [&](int n, bool fine, uint8_t*& q, float*& sc) {
+    if (fine) { CK(hipExtMallocWithFlags((void**)&q, (size_t)MX * n, hipDeviceMallocFinegrained)); CK(hipExtMallocWithFlags((void**)&sc, (size_t)MX * n / 32 * 4, hipDeviceMallocFinegrained)); }
+    else { CK(hipMalloc(&q, (size_t)MX * n)); CK(hipMalloc(&sc, (size_t)MX * n / 32 * 4)); }
+  };
+  auto iflag = [&](bool fine) { int* f; if (fine) CK(hipExtMallocWithFlags((void**)&f, 64, hipDeviceMallocFinegrained)); else CK(hipMalloc(&f, 64)); CK(hipMemset(f, 0, 64)); return f; };
+  // die 0
+  CK(hipSetDevice(0));
+  hipStream_t s0; CK(hipStreamCreateWithFlags(&s0, hipStreamNonBlocking));
+  float *o0, *oa0, *out0, *ref0; uint8_t* Bq; float* Bs;
+  CK(hipMalloc(&o0, (size_t)MX * Kt * 4)); CK(hipMalloc(&oa0, (size_t)MX * Na * 4)); CK(hipMalloc(&out0, (size_t)MX * E * 4)); CK(hipMalloc(&ref0, (size_t)MX * E * 4));
+  CK(hipMemset(oa0, 0, (size_t)MX * Na * 4));
+  { std::vector<float> h((size_t)MX * Kt); unsigned sd = 7; for (auto& v : h) { sd = sd * 1664525u + 1013904223u; v = ((int)(sd >> 9) - (1 << 22)) / float(1 << 22); }
+    CK(hipMemcpy(o0, h.data(), h.size() * 4, hipMemcpyHostToDevice)); }
+  codes(Kt, false, Bq, Bs);
+  uint8_t *mah_q; float* mah_s; codes(ha, true, mah_q, mah_s);
+  float* mb_out; CK(hipExtMallocWithFlags((void**)&mb_out, (size_t)MX * hb * 4, hipDeviceMallocFinegrained));
+  int *flag_h = iflag(true), *done_h = iflag(false);
+  // die 1
+  CK(hipSetDevice(1));
+  hipStream_t s1; CK(hipStreamCreateWithFlags(&s1, hipStreamNonBlocking));
+  uint8_t *ocq, *acq, *mo_q, *ma_q; float *ocs, *acs, *mo_s, *ma_s, *oa1, *out1;
+  codes(ho, false, ocq, ocs); codes(Na, false, acq, acs); codes(ho, true, mo_q, mo_s); codes(ha, true, ma_q, ma_s);
+  CK(hipMalloc(&oa1, (size_t)MX * Na * 4)); CK(hipMemset(oa1, 0, (size_t)MX * Na * 4)); CK(hipMalloc(&out1, (size_t)MX * hb * 4));
+  int *flag_d = iflag(true), *done_d = iflag(false);
+  int to_d = 0, to_h = 0;
+  CK(hipSetDevice(0));
+  auto reg = [](const void* src, int sl, void* dst, int dl, int wd) { return XRegion{src, sl, dst, dl, wd}; };
+  const XRegion none{nullptr, 0, nullptr, 0, 0};
+  const int lpr_a = fp8_lpr(Na, Ka), lpr_b = fp8_lpr(E, Na);
+  auto full = [&](int l, int M, float* out) {
+    fp8_quant_act(o0, Bq, Bs, M, Kt, s0);
+    fp8_gemv(w0[l].aq, w0[l].as, Na, Ka, R, Fp8Act{Bq, Bs}, M, oa0, s0);
+    fp8_quant_act(oa0, Bq, Bs, M, Na, s0);
+    fp8_gemv(w0[l].bq, w0[l].bs, E, Na, E, Fp8Act{Bq, Bs}, M, out, s0);
+  };
+  auto split = [&](int l, int M, float* out) {
+    fp8_quant_act(o0, Bq, Bs, M, Kt, s0);
+    const int v_o = ++to_d, v_a = ++to_d, v_ah = ++to_h, v_out = ++to_h;
+    k_xdie_put(reg(Bq + ho, Kt, mo_q, ho, ho), reg(Bs + ho / 32, Kt / 32 * 4, mo_s, ho / 32 * 4, ho / 32 * 4), M, done_h, flag_d, v_o, s0);
+    CK(hipSetDevice(1));
+    k_xdie_get(reg(mo_q, ho, ocq, ho, ho), reg(mo_s, ho / 32 * 4, ocs, ho / 32 * 4, ho / 32 * 4), M, flag_d, v_o, s1);
+    fp8_gemv_ld(w1[l].aq, w1[l].as, ha, Ka, R, Fp8Act{ocq, ocs}, M, oa1 + ha, s1, lpr_a, 0, ho, Na);
+    fp8_quant_act(oa1, acq, acs, M, Na, s1);
+    k_xdie_put(reg(acq + ha, Na, mah_q, ha, ha), reg(acs + ha / 32, Na / 32 * 4, mah_s, ha / 32 * 4, ha / 32 * 4), M, done_d, flag_h, v_ah, s1);
+    k_xdie_get(reg(ma_q, ha, acq, Na, ha), reg(ma_s, ha / 32 * 4, acs, Na / 32 * 4, ha / 32 * 4), M, flag_d, v_a, s1);
+    fp8_gemv_ld(w1[l].bq, w1[l].bs, hb, Na, hb, Fp8Act{acq, acs}, M, out1, s1, lpr_b, 0, Na, hb);
+    k_xdie_put(reg(out1, hb * 4, mb_out, hb * 4, hb * 4), none, M, done_d, flag_h, v_out, s1);
+    CK(hipSetDevice(0));
+    fp8_gemv_ld(w0[l].aq, w0[l].as, ha, Ka, R, Fp8Act{Bq, Bs}, M, oa0, s0, lpr_a, 0, Kt, Na);
+    fp8_quant_act(oa0, Bq, Bs, M, Na, s0);
+    k_xdie_put(reg(Bq, Na, ma_q, ha, ha), reg(Bs, Na / 32 * 4, ma_s, ha / 32 * 4, ha / 32 * 4), M, done_h, flag_d, v_a, s0);
+    k_xdie_get(reg(mah_q, ha, Bq + ha, Na, ha), reg(mah_s, ha / 32 * 4, Bs + ha / 32, Na / 32 * 4, ha / 32 * 4), M, flag_h, v_ah, s0);
+    fp8_gemv_ld(w0[l].bq, w0[l].bs, hb, Na, hb, Fp8Act{Bq, Bs}, M, out, s0, lpr_b, 0, Na, E);
+    k_xdie_get(reg(mb_out, hb * 4, out + hb, E * 4, hb * 4), none, M, flag_h, v_out, s0);
+  };
+  using C = std::chrono::steady_clock;
+  printf("# bench-xdie proj: wo_a + wo_b x %d layers, us per layer (device time of a pass / %d)\n", L, L);
+  printf("M   full    split   saved   bits   host submit: full split\n");
+  for (int M = 1; M <= 8; M++) {
+    double best[2] = {1e9, 1e9}, sub[2] = {1e9, 1e9};
+    for (int rep = 0; rep < 6; rep++)
+      for (int v = 0; v < 2; v++) {
+        CK(hipDeviceSynchronize());
+        auto t0 = C::now();
+        for (int l = 0; l < L; l++) { if (v) split(l, M, out0); else full(l, M, ref0); }
+        sub[v] = std::min(sub[v], std::chrono::duration<double, std::micro>(C::now() - t0).count() / L);
+        CK(hipStreamSynchronize(s0));
+        best[v] = std::min(best[v], std::chrono::duration<double, std::micro>(C::now() - t0).count() / L);
+      }
+    std::vector<float> a((size_t)M * E), b((size_t)M * E);
+    CK(hipMemcpy(a.data(), ref0, a.size() * 4, hipMemcpyDeviceToHost)); CK(hipMemcpy(b.data(), out0, b.size() * 4, hipMemcpyDeviceToHost));
+    printf("%d %7.1f %7.1f %7.1f   %s   %7.1f %7.1f\n", M, best[0], best[1], best[0] - best[1], memcmp(a.data(), b.data(), a.size() * 4) ? "DIFFER" : "same", sub[0], sub[1]);
+  }
+  return 0;
+}
diff --git a/ds-completion/hip/fp8_gemv.h b/ds-completion/hip/fp8_gemv.h
index 07df698..9d59b4c 100644
--- a/ds-completion/hip/fp8_gemv.h
+++ b/ds-completion/hip/fp8_gemv.h
@@ -37,6 +37,11 @@ void fp8_gemv_cfg(const uint8_t* w, const uint8_t* w_scale, int N, int K, int ro
                   float* y, hipStream_t stream, int lpr, int r);
 void fp8_gemv(const uint8_t* w, const uint8_t* w_scale, int N, int K, int rows_per_group, Fp8Act x, int M,
               float* y, hipStream_t stream);
+// A slice of a matrix's rows (README step 76: attention's output over dies 0-1): ldx is the input's
+// row length in codes (its scales: ldx / 32), ldy the output's (0: K * groups and N). lpr must be
+// the whole matrix's (fp8_lpr of its N), so every row gets the same bits as in a whole call.
+void fp8_gemv_ld(const uint8_t* w, const uint8_t* w_scale, int N, int K, int rows_per_group, Fp8Act x, int M,
+                 float* y, hipStream_t stream, int lpr, int r, int ldx, int ldy);
 // the lanes-per-row split fp8_gemv uses for a shape (it fixes every output's order of additions)
 int fp8_lpr(int N, int K);
 // Any number of inputs (prompt chunks): tiles of mt inputs, r rows per lane group; every result
diff --git a/ds-completion/hip/fp8_gemv.hip b/ds-completion/hip/fp8_gemv.hip
index 6b5aecd..f9d3ba8 100644
--- a/ds-completion/hip/fp8_gemv.hip
+++ b/ds-completion/hip/fp8_gemv.hip
@@ -77,7 +77,8 @@ __device__ inline float dot2(uint32_t a, uint32_t b, float c) {
 template <int LPR, int R, int M>
 __global__ void __launch_bounds__(256) fp8_gemv_kernel(const uint8_t* __restrict__ w, const uint8_t* __restrict__ ws,
                                                        int N, int K, int rpg, const uint8_t* __restrict__ xq,
-                                                       const float* __restrict__ xs, float* __restrict__ y) {
+                                                       const float* __restrict__ xs, float* __restrict__ y, int ldx,
+                                                       int ldy) {
   const int lane = threadIdx.x & 63;
