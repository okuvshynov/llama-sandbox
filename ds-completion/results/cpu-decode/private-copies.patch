+// per thread: nx input activations (E values) and na activations (F values), sized
+void CpuMoeKernel::size_private(int nx, int na) {
+  t_xc.resize(n_threads);
+  t_ac.resize(n_threads);
+  for (int i = 0; i < n_threads; i++) {
+    if ((int)t_xc[i].size() < nx) t_xc[i].resize(nx);
+    if ((int)t_ac[i].size() < na) t_ac[i].resize(na);
+    for (int j = 0; j < nx; j++) if (t_xc[i][j].nb != E / QB) canon_act_size(E, t_xc[i][j]);
+    for (int j = 0; j < na; j++) if (t_ac[i][j].nb != F / QB) canon_act_size(F, t_ac[i][j]);
+  }
