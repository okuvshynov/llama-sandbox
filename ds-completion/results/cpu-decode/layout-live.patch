+// ---- README step 91: some layers' experts copied to RAM for the CPU
+
+
+void Runtime::copy_cpu_layers() {
+  cpu_copy.assign(hp.n_layer, nullptr);
+  if (opt.cpu_layout_layers.empty()) return;
+  if (!opt.canon && !opt.cpu_layout_control) throw std::runtime_error("--cpu-layout: the CPU layout has canonical kernels only (--canon)");
+  const auto t0 = Clock::now();
+  const int nt = std::max(1, opt.n_threads);
+  size_t total = 0;
+  for (int L : opt.cpu_layout_layers) {
+    if (L < 0 || L >= hp.n_layer || !m.layers[L].gate_exps || cpu_copy[L])
+      throw std::runtime_error("--cpu-layout: layer " + std::to_string(L) + " (out of range, without routed experts, or twice)");
+    const ggml_tensor* src[3] = {m.layers[L].gate_exps, m.layers[L].up_exps, m.layers[L].down_exps};
+    auto* c = new CpuLayerCopy;
+    c->control = opt.cpu_layout_control;
+    const int nexp = (int)src[0]->ne[2];
+    auto al = [](size_t n) { return (n + 63) / 64 * 64; };
+    size_t off_c[3], off_s[3], o = 0;
+    for (int i = 0; i < 3; i++) {
+      const int K = (int)src[i]->ne[0], N = (int)src[i]->ne[1], nb = K / 32;
+      if (src[i]->type != GGML_TYPE_MXFP4 || nb % 4 || (size_t)src[i]->nb[1] != (size_t)nb * 17 || (int)src[i]->ne[2] != nexp)
+        throw std::runtime_error("--cpu-layout: layer " + std::to_string(L) + ": unexpected expert tensor");
+      off_c[i] = o;
+      if (c->control) {
+        o += al(ggml_nbytes(src[i]));
+        off_s[i] = 0;
+        continue;
+      }
+      c->lay.nb[i] = nb;
+      c->lay.codes_per_expert[i] = (size_t)N * nb * 16;
+      c->lay.scales_per_expert[i] = (size_t)N * nb;
+      o += al(c->lay.codes_per_expert[i] * nexp);
+      off_s[i] = o;
+      o += al(c->lay.scales_per_expert[i] * nexp);
+    }
+    constexpr size_t kHuge = (size_t)2 << 20;
+    c->bytes = (o + 64 + kHuge - 1) / kHuge * kHuge;  // + 64: canon_dot_rows' scale gather reads 3 bytes past a row's end
+    c->buf = (uint8_t*)aligned_alloc(kHuge, c->bytes);
+    if (!c->buf) throw std::runtime_error("--cpu-layout: out of memory");
+    madvise(c->buf, c->bytes, MADV_HUGEPAGE);
+    std::vector<std::thread> th;
+    for (int w = 0; w < nt; w++)
+      th.emplace_back([&, w] {
+        for (int e = w; e < nexp; e += nt)
+          for (int i = 0; i < 3; i++) {
+            const uint8_t* se = (const uint8_t*)src[i]->data + (size_t)e * src[i]->nb[2];
+            if (c->control)
+              memcpy(c->buf + off_c[i] + (size_t)e * src[i]->nb[2], se, src[i]->nb[2]);
+            else
+              canon_repack64(se, src[i]->nb[1], (int)src[i]->ne[1], c->lay.nb[i], c->buf + off_c[i] + e * c->lay.codes_per_expert[i],
+                             c->buf + off_s[i] + e * c->lay.scales_per_expert[i]);
+          }
+      });
+    for (auto& t : th) t.join();
+    memset(c->buf + o, 0, c->bytes - o);
+    for (int i = 0; i < 3; i++) {
+      if (c->control) {
+        c->t[i] = *src[i];
+        c->t[i].data = c->buf + off_c[i];
+      } else {
+        c->lay.codes[i] = c->buf + off_c[i];
+        c->lay.scales[i] = c->buf + off_s[i];
+      }
+    }
+    cpu_copy[L] = c;
+    total += c->bytes;
+  }
+  fprintf(stderr, "# runtime: %zu layers' experts copied for the CPU (%s, %s) in %.1f s\n", opt.cpu_layout_layers.size(),
+          opt.cpu_layout_control ? "the GGUF's layout: the control" : "the CPU layout", fmt_bytes((double)total).c_str(),
+          ms_since(t0) / 1000);
+}
+
+CpuExperts Runtime::cpu_experts(int L) const {
+  const Layer& hl = m.layers[L];
+  const CpuLayerCopy* c = cpu_copy[L];
+  if (c && c->control) return CpuExperts{&c->t[0], &c->t[1], &c->t[2], hp.swiglu_clamp[L]};
+  CpuExperts ce{hl.gate_exps, hl.up_exps, hl.down_exps, hp.swiglu_clamp[L]};
+  if (c) ce.lay = &c->lay;
+  return ce;
+}
