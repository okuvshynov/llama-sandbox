+namespace {
+
+constexpr int kPrefetch64 = 8192;  // README step 83: 8 KB ahead (none 0.36 ms per cold call, 4 KB 0.28, 8 KB 0.256, 16 KB 0.275)
+
+// the line of blocks 4q .. 4q + 3 of a group: blocks 4q, 4q + 1 in the low nibbles (the register
+// canon_dot_rows builds for them) and 4q + 2, 4q + 3 in the high ones
+inline void decode64(const Consts& K, const uint8_t* line, __m512i& wA, __m512i& wB) {
+  const __m512i v = _mm512_loadu_si512(line);
+  wA = _mm512_shuffle_epi8(K.lut, _mm512_and_si512(v, K.low4));
+  wB = _mm512_shuffle_epi8(K.lut, _mm512_and_si512(_mm512_srli_epi16(v, 4), K.low4));
+}
+
+template <int R>
+inline void dot_rows64_r(const Consts& K, const uint8_t* codes, const uint8_t* scales, int nb, const CanonAct& a, float* y) {
+  const size_t crow = (size_t)nb * 16;
+  __m512 acc[R];
+  for (int i = 0; i < R; i++) acc[i] = _mm512_setzero_ps();
+  for (int b0 = 0; b0 < nb; b0 += 16) {
+    const int nk = nb - b0 >= 16 ? 8 : (nb - b0) / 2;  // even: nb is a multiple of 4
+    const __mmask16 live = nk == 8 ? (__mmask16)0xFFFF : (__mmask16)((1u << (2 * nk)) - 1);
+    __m512i T[R][8];
+    for (int k = 0; k < 8; k += 2) {
+      if (k >= nk) {
+        for (int i = 0; i < R; i++) T[i][k] = T[i][k + 1] = _mm512_setzero_si512();
+        continue;
+      }
+      const size_t offA = (size_t)(b0 + 2 * k) * QB, offB = offA + 2 * QB;
+      const __m512i a2 = _mm512_loadu_si512(a.d2.data() + offA), a1 = _mm512_loadu_si512(a.d1.data() + offA),
+                    a0 = _mm512_loadu_si512(a.d0.data() + offA);
+      const __m512i b2 = _mm512_loadu_si512(a.d2.data() + offB), b1 = _mm512_loadu_si512(a.d1.data() + offB),
+                    bb0 = _mm512_loadu_si512(a.d0.data() + offB);
+      for (int i = 0; i < R; i++) {
+        const uint8_t* line = codes + i * crow + (size_t)(b0 + 2 * k) * 16;
+        _mm_prefetch((const char*)line + kPrefetch64, _MM_HINT_T1);
+        __m512i wA, wB;
+        decode64(K, line, wA, wB);
+        __m512i t = _mm512_dpbusd_epi32(_mm512_setzero_si512(), wA, a2);
+        t = _mm512_dpbusd_epi32(_mm512_slli_epi32(t, 7), wA, a1);
+        T[i][k] = _mm512_dpbusd_epi32(_mm512_slli_epi32(t, 7), wA, a0);
+        __m512i u = _mm512_dpbusd_epi32(_mm512_setzero_si512(), wB, b2);
+        u = _mm512_dpbusd_epi32(_mm512_slli_epi32(u, 7), wB, b1);
+        T[i][k + 1] = _mm512_dpbusd_epi32(_mm512_slli_epi32(u, 7), wB, bb0);
+      }
+    }
+    const __m512i corr = _mm512_maskz_loadu_epi32(live, a.corr.data() + b0);
+    const __m512 c = _mm512_maskz_loadu_ps(live, a.c.data() + b0);
+    for (int i = 0; i < R; i++) {
+      const __m512i S = _mm512_sub_epi32(_mm512_permutexvar_epi32(K.unperm, reduce8(T[i])), corr);
+      const __m512i e = _mm512_cvtepu8_epi32(_mm_maskz_loadu_epi8(live, scales + (size_t)i * nb + b0));
+      const __m512 scale = _mm512_mul_ps(_mm512_castsi512_ps(_mm512_slli_epi32(e, 23)), c);
+      acc[i] = _mm512_mask_add_ps(acc[i], live, acc[i], _mm512_mul_ps(_mm512_cvtepi32_ps(S), scale));
+    }
+  }
+  for (int i = 0; i < R; i++) {
+    __m512 v = acc[i];
+    for (int j = 0; j < 4; j++) v = _mm512_add_ps(v, _mm512_permutexvar_ps(K.xor_idx[j], v));
+    y[i] = _mm512_cvtss_f32(v);
+  }
+}
+
+// dot_rows_tile on the layout: the rows' decoded weights to an L1 buffer, each activation's
+// digits loaded once for the R rows; per (row, activation) exactly dot_rows_r's steps
+template <int R>
+inline void dot_rows64_tile(const Consts& K, const uint8_t* codes, const uint8_t* scales, int nb, const CanonAct* const* a, int nx,
+                            float* const* y, int r, __m512* acc) {
+  const size_t crow = (size_t)nb * 16;
+  alignas(64) __m512i wb[R][8];
+  for (int j = 0; j < nx * R; j++) acc[j] = _mm512_setzero_ps();
+  for (int b0 = 0; b0 < nb; b0 += 16) {
+    const int nk = nb - b0 >= 16 ? 8 : (nb - b0) / 2;
+    const __mmask16 live = nk == 8 ? (__mmask16)0xFFFF : (__mmask16)((1u << (2 * nk)) - 1);
+    __m512 escale[R];
+    for (int i = 0; i < R; i++) {
+      for (int k = 0; k < nk; k += 2) {
+        const uint8_t* line = codes + i * crow + (size_t)(b0 + 2 * k) * 16;
+        _mm_prefetch((const char*)line + kPrefetch64, _MM_HINT_T1);
+        decode64(K, line, wb[i][k], wb[i][k + 1]);
+      }
+      const __m512i e = _mm512_cvtepu8_epi32(_mm_maskz_loadu_epi8(live, scales + (size_t)i * nb + b0));
+      escale[i] = _mm512_castsi512_ps(_mm512_slli_epi32(e, 23));
+    }
+    for (int j = 0; j < nx; j++) {
+      const CanonAct& aj = *a[j];
+      __m512i T[R][8];
+      for (int k = 0; k < 8; k++) {
+        if (k >= nk) {
+          for (int i = 0; i < R; i++) T[i][k] = _mm512_setzero_si512();
+          continue;
+        }
+        const size_t off = (size_t)(b0 + 2 * k) * QB;
+        const __m512i d2 = _mm512_loadu_si512(aj.d2.data() + off), d1 = _mm512_loadu_si512(aj.d1.data() + off),
+                      d0 = _mm512_loadu_si512(aj.d0.data() + off);
+        for (int i = 0; i < R; i++) {
+          const __m512i w = _mm512_load_si512(&wb[i][k]);
+          __m512i t = _mm512_dpbusd_epi32(_mm512_setzero_si512(), w, d2);
+          t = _mm512_dpbusd_epi32(_mm512_slli_epi32(t, 7), w, d1);
+          T[i][k] = _mm512_dpbusd_epi32(_mm512_slli_epi32(t, 7), w, d0);
+        }
+      }
+      const __m512i corr = _mm512_maskz_loadu_epi32(live, aj.corr.data() + b0);
+      const __m512 c = _mm512_maskz_loadu_ps(live, aj.c.data() + b0);
+      for (int i = 0; i < R; i++) {
+        const __m512i S = _mm512_sub_epi32(_mm512_permutexvar_epi32(K.unperm, reduce8(T[i])), corr);
+        __m512& ac = acc[j * R + i];
+        ac = _mm512_mask_add_ps(ac, live, ac, _mm512_mul_ps(_mm512_cvtepi32_ps(S), _mm512_mul_ps(escale[i], c)));
+      }
+    }
+  }
+  for (int j = 0; j < nx; j++)
+    for (int i = 0; i < R; i++) {
+      __m512 v = acc[j * R + i];
+      for (int s = 0; s < 4; s++) v = _mm512_add_ps(v, _mm512_permutexvar_ps(K.xor_idx[s], v));
+      y[j][r + i] = _mm512_cvtss_f32(v);
+    }
+}
+
+}  // namespace
+
+void canon_dot_rows64(const uint8_t* codes, const uint8_t* scales, int nb, const CanonAct& a, int r0, int r1, float* y) {
+  static const Consts K;
+  const size_t crow = (size_t)nb * 16;
+  int r = r0;
+  for (; r + 4 <= r1; r += 4) dot_rows64_r<4>(K, codes + (size_t)r * crow, scales + (size_t)r * nb, nb, a, y + r);
+  for (; r < r1; r++) dot_rows64_r<1>(K, codes + (size_t)r * crow, scales + (size_t)r * nb, nb, a, y + r);
+}
+
+void canon_dot_rows64_multi(const uint8_t* codes, const uint8_t* scales, int nb, const CanonAct* const* a, int nx, int r0, int r1,
+                            float* const* y) {
+  static const Consts K;
+  thread_local struct Acc {
+    __m512* p = nullptr;
+    size_t n = 0;
+    ~Acc() { free(p); }
+  } acc;
+  if (acc.n < (size_t)nx * 2) {
+    free(acc.p);
+    acc.n = (size_t)nx * 2;
+    acc.p = (__m512*)aligned_alloc(64, acc.n * sizeof(__m512));
+  }
+  constexpr int XB = 8;
+  const size_t crow = (size_t)nb * 16;
+  int r = r0;
+  for (; r + 2 <= r1; r += 2)
+    for (int j = 0; j < nx; j += XB)
+      dot_rows64_tile<2>(K, codes + (size_t)r * crow, scales + (size_t)r * nb, nb, a + j, std::min(XB, nx - j), y + j, r, acc.p);
+  for (; r < r1; r++)
+    for (int j = 0; j < nx; j += XB)
+      dot_rows64_tile<1>(K, codes + (size_t)r * crow, scales + (size_t)r * nb, nb, a + j, std::min(XB, nx - j), y + j, r, acc.p);
+}
