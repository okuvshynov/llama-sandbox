+// ---- the CPU layout (README steps 83, 91)
+
+void canon_repack64(const uint8_t* src, size_t row_bytes, int N, int nb, uint8_t* codes, uint8_t* scales) {
+  for (int r = 0; r < N; r++) {
+    const uint8_t* row = src + (size_t)r * row_bytes;
+    uint8_t* cr = codes + (size_t)r * nb * 16;
+    for (int b = 0; b < nb; b++) scales[(size_t)r * nb + b] = row[(size_t)b * BLK];
+    auto code = [&](int i) {  // element i of the row (block i / 32: byte j low = j, high = j + 16)
+      const uint8_t* blk = row + (size_t)(i / 32) * BLK + 1;
+      const int j = i % 32;
+      return j < 16 ? blk[j] & 15 : blk[j - 16] >> 4;
+    };
+    for (int g = 0; g < nb / 4; g++)
+      for (int j = 0; j < 64; j++) cr[g * 64 + j] = (uint8_t)(code(128 * g + j) | code(128 * g + 64 + j) << 4);
+  }
+}
