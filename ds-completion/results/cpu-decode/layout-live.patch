+++ b/ds-completion/scripts/trace_cpu_copy.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""The CPU's experts per layer copy (README step 91), from --trace files of runs with --cpu-layout.
+
+The "CPU experts L<n>" spans carry "cpu copy": 0 the GGUF's rows, 1 the CPU layout, 2 the control
+(a copy in the GGUF's layout). Per kind, in generation: layer calls, experts, ms, and ms per
+distinct expert (median and mean per call, the gate_up and down phases, total ms / experts).
+
+  scripts/trace_cpu_copy.py TRACE.json[.gz] ...
+"""
+import gzip
+import json, sys, statistics as st
+from collections import defaultdict
+for path in sys.argv[1:]:
+    ev = [e for e in json.load(gzip.open(path, 'rt') if path.endswith('.gz') else open(path))['traceEvents'] if e.get('ph') == 'X']
+    gen0 = min(e['ts'] for e in ev if e['name'].startswith('verify '))
+    cpu = [e for e in ev if e['name'].startswith('CPU experts L') and e['ts'] >= gen0]
+    host = sorted([e for e in ev if e['tid'] == 1 and e['name'].startswith('cpu.') and e['ts'] >= gen0], key=lambda e: e['ts'])
+    by = defaultdict(lambda: defaultdict(list))
+    for c in cpu:
+        a = c['args']; k = a.get('cpu copy', 0); d = a['distinct experts']
+        if d == 0: continue
+        by[k]['ms per expert'].append(c['dur'] / 1000 / d)
+        by[k]['n'].append(1); by[k]['experts'].append(d); by[k]['ms'].append(c['dur'] / 1000)
+        for ph in ('cpu.gate_up', 'cpu.down'):
+            p = [h for h in host if h['name'] == ph and c['ts'] - 1 <= h['ts'] <= c['ts'] + c['dur']]
+            if p: by[k][ph + ' per expert'].append(p[-1]['dur'] / 1000 / d)
+    print(f"# {path.split('/')[-1]}")
+    for k in sorted(by):
+        b = by[k]
+        print(f"  copy {k} ({['GGUF', 'CPU layout', 'control copy'][k]}): {len(b['n'])} layer calls, {sum(b['experts'])} experts, "
+              f"{sum(b['ms']):.0f} ms; per expert: median {st.median(b['ms per expert']):.3f} mean {st.mean(b['ms per expert']):.3f} ms; "
+              f"gate_up {st.median(b['cpu.gate_up per expert']):.3f}, down {st.median(b['cpu.down per expert']):.3f}; "
+              f"total ms / experts {sum(b['ms']) / sum(b['experts']):.3f}")
