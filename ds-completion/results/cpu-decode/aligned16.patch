 #include <cstddef>
 #include <cstdint>
+#include <new>
 #include <vector>
 
+// 64-byte aligned storage (README step 79): a cache line per 16 blocks of corr / c and per 2 blocks
+// of each digit array, so threads writing disjoint 16-block ranges never share a line
+template <class T>
+struct Aligned64 {
+  using value_type = T;
+  Aligned64() = default;
+  template <class U> Aligned64(const Aligned64<U>&) {}
+  T* allocate(size_t n) { return static_cast<T*>(::operator new(n * sizeof(T), std::align_val_t(64))); }
+  void deallocate(T* p, size_t) { ::operator delete(p, std::align_val_t(64)); }
+  template <class U> bool operator==(const Aligned64<U>&) const { return true; }
+  template <class U> bool operator!=(const Aligned64<U>&) const { return false; }
+};
+template <class T> using AVec = std::vector<T, Aligned64<T>>;
+
 // The activations of one GEMV, fake-quantized (act_quant(x, 32, ue8m0)) and split for the
 // integer block sums.
 struct CanonAct {
   int nb = 0;
   // 2^9 x = d0 + d1 2^7 + d2 2^14, every digit with the sign of x and |d| <= 127; [nb * 32] each,
   // natural element order within a block
-  std::vector<int8_t> d0, d1, d2;
-  std::vector<int32_t> corr;  // per block: 12 * sum of 2^9 x (the weights enter as 2 w + 12 >= 0)
-  std::vector<float> c;       // per block: s_b * 2^-10
-  std::vector<int32_t> x9;    // [nb * 32]: 2^9 x (for the scalar specification)
+  AVec<int8_t> d0, d1, d2;
+  AVec<int32_t> corr;  // per block: 12 * sum of 2^9 x (the weights enter as 2 w + 12 >= 0)
+  AVec<float> c;       // per block: s_b * 2^-10
+  AVec<int32_t> x9;    // [nb * 32]: 2^9 x (for the scalar specification)
 };
 
