#version 450
// Pass 1 of the 2-pass MXFP4 vecmat: partial dot products per K-tile.
//
// The structure is lyrae's BandwidthImpl (measured 1.66x over MPS at batch 1 on
// these same dies, dense version 720-791 GB/s), ported to Vulkan and given a
// dequant inner loop: split K into tiles so parallelism is (columns x k_tiles x
// experts) instead of (columns), because the one-workgroup-per-row shape was
// measured 10x SLOWER there — at batch 1 the die starves without the K-split.
//
// Weights are *repacked* on the host into two planes (our freedom — see
// PLAN.md decode-kernel):
//   nibble plane  uvec2[K/2][M/8]  entry t = columns 8t..8t+7 at rows k (x)
//                                  and k+1 (y), 4b each — one 8-byte load
//                                  covers 16 weights (E2)
//   scale plane   u8 [K/32][M]     e8m0 scale for (k-block, column)
// so adjacent threads load adjacent uvec2s — fully coalesced — and the scale
// byte never interrupts the data stream, unlike ggml's 17-byte block.
//
// MXFP4 semantics copied exactly from ggml (ggml-quants.c dequantize_row_mxfp4,
// ggml-common.h kvalues_fp4, ggml-impl.h ggml_e8m0_to_fp32_half): value =
// kvalue(nibble) * e8m0_half(scale), kvalues doubled-e2m1 {0,1,2,3,4,6,8,12}
// with bit 3 the sign. Validated against ggml's CPU kernel by the host.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer Plane  { uvec2 w[];  };  // nibble plane, k-paired
layout(std430, binding = 1) readonly  buffer Scale  { uint  s[];  };  // scale plane, u8 as u32
layout(std430, binding = 2) readonly  buffer X      { float x[];  };  // [K]
layout(std430, binding = 3) writeonly buffer Part   { float p[];  };  // [E][KT][M]

layout(push_constant) uniform PC {
    uint K;            // reduction length
    uint M;            // output columns
    uint tile_k;       // K elements per tile (multiple of 32, <= 128)
    uint n_tiles;      // K / tile_k
    uint w_stride;     // uvec2s per expert in the nibble plane = K*M/16
    uint s_stride;     // u32s per expert in the scale plane    = (K/32)*M/4
} pc;

// Doubled-e2m1 magnitudes for nibble&7, packed 4 bits each: {0,1,2,3,4,6,8,12}.
const uint TBL = 0xC8643210u;

shared float xs[128];        // this tile's slice of x
shared float lut[16];        // nibble -> signed value, built once per workgroup

float e8m0_half(uint e) {
    // ggml_e8m0_to_fp32_half, exactly: denormal patterns below e=2.
    uint bits = e < 2u ? (0x00200000u << e) : ((e - 1u) << 23);
    return uintBitsToFloat(bits);
}

void main() {
    const uint tid  = gl_LocalInvocationID.x;
    // E6: four columns per thread — two threads share one u32 column group,
    // each taking one 16-bit half. Doubles the workgroup count (occupancy 3 ->
    // 6 waves/SIMD at tile 128) without touching the partials traffic, which
    // is what makes it a clean test of the occupancy hypothesis.
    const uint gtid = gl_WorkGroupID.x * 256u + tid;
    const uint tcol = gtid >> 1u;                      // which u32 column group
    const uint half_sel = (gtid & 1u) * 16u;           // which 16-bit half of it
    const uint kt   = gl_WorkGroupID.y;                // which K-tile
    const uint e    = gl_WorkGroupID.z;                // which expert slot

    if (tid < 16u) {
        float mag = float((TBL >> (4u * (tid & 7u))) & 0xFu);
        lut[tid] = (tid & 8u) != 0u ? -mag : mag;
    }
    const uint k0 = kt * pc.tile_k;
    for (uint i = tid; i < pc.tile_k; i += 256u) {
        xs[i] = x[k0 + i];
    }
    barrier();

    const uint m8 = pc.M / 8u;
    if (tcol >= m8) return;
    const uint col0 = tcol * 8u + (half_sel >> 2u);    // first of this thread's 4 columns

    const uint wbase = e * pc.w_stride + tcol;
    const uint sbase = e * pc.s_stride;

    float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;

    // 32-element sub-blocks share one scale per column; accumulate the raw
    // sub-sum first and apply the scale once per sub-block, not per weight.
    for (uint sb = 0u; sb < pc.tile_k / 32u; sb++) {
        const uint kb = k0 / 32u + sb;
        float b0 = 0.0, b1 = 0.0, b2 = 0.0, b3 = 0.0;

        for (uint j = 0u; j < 16u; j++) {
            const uint  dk = sb * 32u + 2u * j;
            const float x0 = xs[dk];
            const float x1 = xs[dk + 1u];
            const uvec2 wv = w[wbase + ((k0 + dk) >> 1u) * m8];
            const uint hx = wv.x >> half_sel, hy = wv.y >> half_sel;
            b0 += x0 * lut[(hx >>  0u) & 0xFu] + x1 * lut[(hy >>  0u) & 0xFu];
            b1 += x0 * lut[(hx >>  4u) & 0xFu] + x1 * lut[(hy >>  4u) & 0xFu];
            b2 += x0 * lut[(hx >>  8u) & 0xFu] + x1 * lut[(hy >>  8u) & 0xFu];
            b3 += x0 * lut[(hx >> 12u) & 0xFu] + x1 * lut[(hy >> 12u) & 0xFu];
        }

        // 4 scale bytes for this thread's columns — exactly one u32.
        const uint sc = s[sbase + (kb * pc.M + col0) / 4u];
        a0 += e8m0_half((sc >>  0u) & 0xFFu) * b0;
        a1 += e8m0_half((sc >>  8u) & 0xFFu) * b1;
        a2 += e8m0_half((sc >> 16u) & 0xFFu) * b2;
        a3 += e8m0_half((sc >> 24u) & 0xFFu) * b3;
    }

    const uint pbase = ((e * pc.n_tiles + kt) * pc.M) + col0;
    p[pbase + 0u] = a0;
    p[pbase + 1u] = a1;
    p[pbase + 2u] = a2;
    p[pbase + 3u] = a3;
}
